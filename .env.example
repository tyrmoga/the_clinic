APP_NAME=Clinic Appointment Booking API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/clinic
JWT_SECRET=dev-only-change-me-use-32-bytes-minimum
JWT_TTL_MINUTES=60
AVAILABILITY_CACHE_TTL_SECONDS=10
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_BOOKING_PER_MINUTE=30
TRUSTED_HOSTS=*
CORS_ORIGINS=
MAX_BODY_BYTES=1000000
LOG_LEVEL=INFO
